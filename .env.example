# ─────────────────────────────────────────────────
# AI Meeting-to-Action — Environment Variables
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────

# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5000

# AI / Claude API (required for task extraction & chat)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# JWT Auth
JWT_SECRET=change_this_to_a_long_random_string_in_production
JWT_EXPIRES=7d

# MongoDB (optional — leave blank to use in-memory store)
# MONGODB_URI=mongodb://localhost:27017/ai-meeting-action

# ─────────────────────────────────────────────────
# Transcription API Keys (used by frontend meet-recorder)
# Add your chosen provider's key here for reference
# ─────────────────────────────────────────────────
# DEEPGRAM_API_KEY=your_deepgram_key
# OPENAI_API_KEY=your_openai_key
# GOOGLE_STT_API_KEY=your_google_stt_key
